# Q5_K_S from bartowski/Qwen_Qwen3-VL-8B-Instruct-GGUF (local GGUF)
# Download via: huggingface-cli download bartowski/Qwen_Qwen3-VL-8B-Instruct-GGUF \
#     Qwen_Qwen3-VL-8B-Instruct-Q5_K_S.gguf --local-dir models/
FROM ../models/Qwen_Qwen3-VL-8B-Instruct-Q5_K_S.gguf
FROM ../models/mmproj-Qwen_Qwen3-VL-8B-Instruct-f16.gguf

PARAMETER num_ctx 8192
PARAMETER temperature 1
PARAMETER top_k 20
PARAMETER top_p 0.95
PARAMETER num_predict 512
